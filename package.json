{
  "name": "chatgoose",
  "version": "2.4.2",
  "description": "ChatGoose — Fansly chat workspace extension with kernel-served AI assistance",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm gates && pnpm test && pnpm build",
    "watch": "node esbuild.config.mjs --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gates": "node scripts/check-ai-cutover.mjs"
  },
  "license": "ISC",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/firefox-webext-browser": "^143.0.0",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.1",
    "jsdom": "^28.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@kernel/sdk": "link:./vendor/kernel-sdk",
    "zod": "^4.1.5"
  }
}
