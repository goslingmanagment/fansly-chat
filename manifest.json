{
  "manifest_version": 3,
  "name": "ChatGoose",
  "version": "1.9.6",
  "description": "AI-powered chat assistant for Fansly.com",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "*://fansly.com/*",
    "*://apiv3.fansly.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://fansly.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatGoose",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chatgoose@gosling.agency",
      "strict_min_version": "142.0",
      "update_url": "https://ext.gosling-agency.ru/updates.json",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "personallyIdentifyingInfo",
          "personalCommunications",
          "financialAndPaymentInfo",
          "websiteContent"
        ]
      }
    }
  }
}
